# KiCAD MCP Server environment variables
# Copy this file to .env and adjust as needed

# Backend selection: auto (default), ipc, swig
# KICAD_BACKEND=auto

# KiCAD installation path (auto-detected if not set)
# KICAD_PATH=/usr/share/kicad

# Freerouting JAR path for autorouting
# FREEROUTING_JAR=/path/to/freerouting.jar

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Log file (default: ~/.kicad-mcp/logs/server.log)
# LOG_FILE=/tmp/kicad-mcp.log

# JLCPCB local database path
# JLCPCB_DB_PATH=~/.kicad-mcp/jlcpcb.db

# Backup settings
# MCP_BACKUP_DIR=.mcp-backups
# MCP_BACKUP_RETAIN=10
